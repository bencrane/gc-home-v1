---
import Base from "@/layouts/Base.astro"
import PiecePage from "@/views/PiecePage"
import { getPieces, bySection } from "@/lib/content"
export async function getStaticPaths() {
  const all = await getPieces()
  return bySection(all, "briefings").map((p) => ({ params: { slug: p.slug }, props: { piece: p, more: bySection(all, "briefings").filter((x) => x.slug !== p.slug).slice(0, 4) } }))
}
const { piece, more } = Astro.props
---
<Base title={piece.title} description={piece.dek} image={`/og/${piece.slug}.png`}>
  <PiecePage piece={piece} more={more} />
</Base>
