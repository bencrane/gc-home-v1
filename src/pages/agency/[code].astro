---
import Base from "@/layouts/Base.astro"
import { AgencyView } from "@/views/ReferencePage"
import { agencyPages } from "@/lib/reference"
import { getPieces } from "@/lib/content"
export async function getStaticPaths() { return agencyPages(await getPieces()).map((p) => ({ params: { code: p.code }, props: { page: p } })) }
const { page } = Astro.props
---
<Base title={page.name} description={`Federal contract obligations, recipients, and coverage for ${page.name}.`}>
  <AgencyView page={page} />
</Base>
