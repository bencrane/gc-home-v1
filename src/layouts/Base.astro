---
import "@/index.css"
import Rail from "@/components/site/Rail"
import SiteHeader from "@/components/site/SiteHeader"
import SiteFooter from "@/components/site/SiteFooter"
interface Props { title?: string; description?: string; shell?: boolean; image?: string }
const { title = "Government Contracted", description = "Federal procurement, read from the record.", shell = true, image } = Astro.props
const ogImage = new URL(image ?? "/og/default.png", Astro.site ?? "https://gc-home.onrender.com").href
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://gc-home.onrender.com").href
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const currentPath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || "/" : Astro.url.pathname
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Government Contracted" ? title : `${title} · Government Contracted`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Government Contracted" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Design variant (see src/variants.ts): ?v= wins and is remembered; preview=1 never persists.
      (function () {
        try {
          var p = new URLSearchParams(location.search), q = p.get("v"), prev = p.get("preview") === "1";
          var id = q || localStorage.getItem("gc.variant") || "base";
          if (q && !prev) localStorage.setItem("gc.variant", q);
          document.documentElement.dataset.variant = id;
        } catch (e) { document.documentElement.dataset.variant = "base"; }
      })();
    </script>
  </head>
  <body>
    {shell ? (
      <div id="top" class="grid min-h-dvh grid-cols-1 bg-background text-foreground lg:grid-cols-[6rem_1fr]">
        <Rail />
        <div class="flex min-w-0 flex-col">
          <SiteHeader currentPath={currentPath} />
          <main class="flex-1"><slot /></main>
          <SiteFooter />
        </div>
      </div>
    ) : (
      <slot />
    )}
  </body>
</html>
